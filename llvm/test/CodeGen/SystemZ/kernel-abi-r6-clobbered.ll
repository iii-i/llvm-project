; Test the experimental kernel ABI tweak r6-clobbered.
;
; RUN: llc < %s -mtriple=s390x-linux-gnu -mattr=+soft-float \
; RUN:   -mattr=+experimental-kernel-abi-r6-clobbered | FileCheck %s

declare void @g()
declare i64 @g5(i64, i64, i64, i64, i64)

; %r6 is not saved, and a value that lives across a call does not use it.
define i64 @f1(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e) {
; CHECK-LABEL: f1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    stmg %r13, %r15, 104(%r15)
; CHECK-NEXT:    .cfi_offset %r13, -56
; CHECK-NEXT:    .cfi_offset %r14, -48
; CHECK-NEXT:    .cfi_offset %r15, -40
; CHECK-NEXT:    aghi %r15, -160
; CHECK-NEXT:    .cfi_def_cfa_offset 320
; CHECK-NEXT:    lgr %r13, %r6
; CHECK-NEXT:    brasl %r14, g@PLT
; CHECK-NEXT:    lgr %r2, %r13
; CHECK-NEXT:    lmg %r13, %r15, 264(%r15)
; CHECK-NEXT:    br %r14
  call void @g()
  ret i64 %e
}

; A sibling call with five arguments.
define i64 @f2(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e) {
; CHECK-LABEL: f2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lgr %r0, %r3
; CHECK-NEXT:    lgr %r1, %r2
; CHECK-NEXT:    lgr %r2, %r6
; CHECK-NEXT:    lgr %r3, %r5
; CHECK-NEXT:    lgr %r5, %r0
; CHECK-NEXT:    lgr %r6, %r1
; CHECK-NEXT:    jg g5@PLT
  %r = tail call i64 @g5(i64 %e, i64 %d, i64 %c, i64 %b, i64 %a)
  ret i64 %r
}

; %r6 can be clobbered without saving it.
define i64 @f3(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e) {
; CHECK-LABEL: f3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    stmg %r11, %r15, 88(%r15)
; CHECK-NEXT:    .cfi_offset %r11, -72
; CHECK-NEXT:    .cfi_offset %r12, -64
; CHECK-NEXT:    .cfi_offset %r13, -56
; CHECK-NEXT:    .cfi_offset %r14, -48
; CHECK-NEXT:    .cfi_offset %r15, -40
; CHECK-NEXT:    aghi %r15, -160
; CHECK-NEXT:    .cfi_def_cfa_offset 320
; CHECK-NEXT:    lgr %r13, %r5
; CHECK-NEXT:    lgr %r12, %r4
; CHECK-NEXT:    lgr %r11, %r3
; CHECK-NEXT:    brasl %r14, g5@PLT
; CHECK-NEXT:    lghi %r6, 0
; CHECK-NEXT:    lgr %r3, %r11
; CHECK-NEXT:    lgr %r4, %r12
; CHECK-NEXT:    lgr %r5, %r13
; CHECK-NEXT:    brasl %r14, g5@PLT
; CHECK-NEXT:    lmg %r11, %r15, 248(%r15)
; CHECK-NEXT:    br %r14
  %r = call i64 @g5(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e)
  %s = call i64 @g5(i64 %r, i64 %b, i64 %c, i64 %d, i64 0)
  ret i64 %s
}

