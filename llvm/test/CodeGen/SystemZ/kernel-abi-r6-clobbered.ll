declare void @llvm.va_start(ptr)
declare void @use(ptr)

; A vararg function that saves no call-saved GPR still stores the GPR
; varargs, and restores %r15 by adding the frame size.
define void @f5(i64 %a, ...) {
; CHECK-LABEL: f5:
; CHECK:       # %bb.0:
; CHECK-NEXT:    stmg %r3, %r15, 24(%r15)
; CHECK-NEXT:    .cfi_offset %r15, -40
; CHECK-NEXT:    aghi %r15, -192
; CHECK-NEXT:    .cfi_def_cfa_offset 352
; CHECK-NEXT:    la %r0, 192(%r15)
; CHECK-NEXT:    stg %r0, 184(%r15)
; CHECK-NEXT:    la %r0, 352(%r15)
; CHECK-NEXT:    stg %r0, 176(%r15)
; CHECK-NEXT:    mvghi 160(%r15), 1
; CHECK-NEXT:    mvghi 168(%r15), 0
; CHECK-NEXT:    lg %r0, 192(%r15)
; CHECK-NEXT:    stg %r0, 160(%r15)
; CHECK-NEXT:    aghi %r15, 192
; CHECK-NEXT:    br %r14
  %va = alloca [4 x i64]
  call void @llvm.va_start(ptr %va)
  %p = getelementptr i8, ptr %va, i64 24
  %rsa = load ptr, ptr %p
  %v = load i64, ptr %rsa
  store volatile i64 %v, ptr %va
  ret void
}

