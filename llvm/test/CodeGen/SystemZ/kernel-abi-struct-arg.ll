; RUN:   | FileCheck %s

; A pair after one scalar.
define i64 @f1(i64 %a, { i64, i64 } %b) {
; CHECK-LABEL: f1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    agr %r3, %r4
; CHECK-NEXT:    sgr %r3, %r2
; CHECK-NEXT:    lgr %r2, %r3
; CHECK-NEXT:    br %r14
  %b0 = extractvalue { i64, i64 } %b, 0
  %b1 = extractvalue { i64, i64 } %b, 1
  %s = add i64 %b0, %b1
  %t = sub i64 %s, %a
  ret i64 %t
}

; A pair in %r5:%r6.
define i64 @f2(i64 %a, i64 %b, i64 %c, { i64, i32 } %d) {
; CHECK-LABEL: f2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lgr %r2, %r5
; CHECK-NEXT:    algfr %r2, %r6
; CHECK-NEXT:    br %r14
  %d0 = extractvalue { i64, i32 } %d, 0
  %d1 = extractvalue { i64, i32 } %d, 1
  %ext = zext i32 %d1 to i64
  %s = add i64 %d0, %ext
  ret i64 %s
}

; Only %r6 is left, so the pair goes to the stack, and a later scalar
; takes %r6.  The 4-byte tail is left-justified in its slot.
define i64 @f3(i64 %a, i64 %b, i64 %c, i64 %d, { i64, i32 } %e, i64 %f) {
; CHECK-LABEL: f3:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lg %r2, 160(%r15)
; CHECK-NEXT:    algf %r2, 168(%r15)
; CHECK-NEXT:    agr %r2, %r6
; CHECK-NEXT:    br %r14
  %e0 = extractvalue { i64, i32 } %e, 0
  %e1 = extractvalue { i64, i32 } %e, 1
  %ext = zext i32 %e1 to i64
  %s = add i64 %e0, %ext
  %t = add i64 %s, %f
  ret i64 %t
}

; A 3-byte tail on the stack.
define i64 @f4(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, { i64, i24 } %f) {
; CHECK-LABEL: f4:
; CHECK:       # %bb.0:
