; CHECK-NEXT:    sllg %r2, %r0, 8
; CHECK-NEXT:    ic %r2, 170(%r15)
; CHECK-NEXT:    br %r14
  %f1 = extractvalue { i64, i24 } %f, 1
  %ext = zext i24 %f1 to i64
  ret i64 %ext
}

; A 7-byte tail in a register.
define i64 @f5({ i64, i56 } %a) {
; CHECK-LABEL: f5:
; CHECK:       # %bb.0:
; CHECK-NEXT:    risbg %r2, %r3, 8, 191, 0
; CHECK-NEXT:    br %r14
  %a1 = extractvalue { i64, i56 } %a, 1
  %ext = zext i56 %a1 to i64
  ret i64 %ext
}

; Two pairs in registers, a third one on the stack.
define i64 @f6({ i64, i64 } %a, { i64, i64 } %b, { i64, i64 } %c) {
; CHECK-LABEL: f6:
; CHECK:       # %bb.0:
; CHECK-NEXT:    agr %r2, %r4
; CHECK-NEXT:    ag %r2, 168(%r15)
; CHECK-NEXT:    br %r14
  %a0 = extractvalue { i64, i64 } %a, 0
  %b0 = extractvalue { i64, i64 } %b, 0
  %c1 = extractvalue { i64, i64 } %c, 1
